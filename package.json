    "qa:batch-2-sitemap": "node scripts/check-batch-2-sitemap.mjs",
    "qa:batch-3-build": "node scripts/check-batch-3-windows-build.mjs",
    "qa:batch-4-claims": "node scripts/check-batch-4-qualified-payment-claims.mjs",
    "qa:batch-5-images": "node scripts/check-batch-5-images.mjs",
    "qa:batch-6-schema-geo": "node scripts/check-batch-6-schema-geo.mjs",
    "qa:batch-7-host-redirects": "node scripts/check-batch-7-host-redirects.mjs",
    "qa:batch-8-image-dimensions": "node scripts/check-batch-8-image-dimensions.mjs",
    "qa:batch-9-f10": "node scripts/check-batch-9-f10.mjs",
    "qa:batch-10-metadata": "node scripts/check-batch-10-metadata.mjs",
    "qa:batch-11-internal-links": "node scripts/check-batch-11-internal-links.mjs",
    "images:dimension-cache": "node scripts/build-image-dimension-cache.mjs",
    "qa:sitemap": "node scripts/check-sitemap-indexability.mjs",
    "qa:duplicate-headings": "node scripts/check-duplicate-headings.mjs",
    "qa:claim-risk": "node scripts/check-claim-risk.mjs",
    "qa:coverage": "npm run qa:internal-404 && npm run qa:redirect-chain && npm run qa:sitemap && npm run qa:duplicate-headings && npm run qa:claim-risk",
    "check:seo": "npm run build && npm run validate:seo",
    "build:images": "node scripts/process-production-images.mjs && node scripts/generate-og-default.mjs && node scripts/generate-production-og.mjs && node scripts/generate-og-images.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "find:google-place": "node scripts/find-google-place-id.mjs",
    "test:google-reviews": "node --test src/lib/*.test.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^10.0.8",
    "@fontsource/sarabun": "^5.2.8",
    "astro": "^6.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3"
  }
