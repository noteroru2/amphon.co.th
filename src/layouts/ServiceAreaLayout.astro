---
import BaseLayout from './BaseLayout.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import { getImageAlt, serviceThumbnails } from '../config/images';
import CTAContact from '../components/CTAContact.astro';
import FAQ from '../components/FAQ.astro';
import MacbookServiceAreaContent from '../components/MacbookServiceAreaContent.astro';
import { getMacbookServiceAreaProfile } from '../config/macbook-service-areas';
import {
  absoluteUrl,
  schemaIds,
  createServiceSchema,
  contentDateModified,
  faqSchemaIfVisible,
  resolveOgImage,
} from '../lib/seo';
import { site } from '../config/site';
import { getCanonicalServiceHref } from '../config/seo-policy';
import { serviceAreaSidebarLabel } from '../config/internal-link-map';
import type { BreadcrumbItem } from '../config/site';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'serviceAreas'>;
  service?: CollectionEntry<'services'>;
  area?: CollectionEntry<'areas'>;
  relatedInProvince?: CollectionEntry<'serviceAreas'>[];
}

const { entry, service, area, relatedInProvince = [] } = Astro.props;
const { slug, mainKeyword, ogImage, heroImage, date, updated } = entry.data;
const macbookProfile = entry.data.serviceSlug === 'รับซื้อ-macbook'
  ? getMacbookServiceAreaProfile(slug)
  : undefined;
const title = macbookProfile?.title ?? entry.data.title;
const h1 = macbookProfile?.h1 ?? entry.data.h1 ?? title;
const description = macbookProfile?.description ?? entry.data.description;
const faqs = macbookProfile?.faqs ?? entry.data.faqs;
const { Content } = await render(entry);
const serviceHref = getCanonicalServiceHref(service?.data.slug ?? entry.data.serviceSlug);

const breadcrumbs: BreadcrumbItem[] = [
  { label: 'หน้าแรก', href: '/' },
  { label: 'รับซื้อสินค้า', href: '/รับซื้อสินค้าไอที' },
  ...(service && serviceHref ? [{ label: service.data.title, href: serviceHref }] : []),
  ...(area ? [{ label: area.data.province, href: `/พื้นที่ให้บริการ/${area.data.slug}` }] : []),
  { label: title },
];

const pageUrl = absoluteUrl(`/รับซื้อ/${slug}`);
const resolvedOgImage = (ogImage && ogImage !== '/images/og/og-service-it.webp')
  ? ogImage
  : (service?.data.ogImage ?? ogImage);
// Keep location pages visually aligned with their canonical service page.
// Older generated entries often carry a generic OG graphic (or a mismatched
// legacy image) as heroImage, so prefer the service-specific asset when known.
const resolvedHeroImage = service?.data.heroImage
  ?? serviceThumbnails[entry.data.serviceSlug]
  ?? heroImage;
const pageImage = resolveOgImage(resolvedOgImage, resolvedHeroImage);
const datePublished = date.toISOString();
const dateModified = contentDateModified(date, updated);

const schemaExtras = [
  createServiceSchema({
    pageUrl,
    name: title,
    description,
    serviceType: mainKeyword,
    image: pageImage,
  }),
  ...faqSchemaIfVisible(pageUrl, faqs),
];

const steps = [
  { n: 1, title: 'ส่งรูปผ่าน Line',    desc: 'ส่งรูปสินค้า ระบุรุ่น สภาพ'    },
  { n: 2, title: 'รับราคาเบื้องต้น',   desc: 'แจ้งราคาเบื้องต้นหลังได้รับข้อมูลครบในช่วงเวลาทำการ'    },
  { n: 3, title: 'ยืนยันวิธีตรวจรับ',     desc: 'นัดตรวจหรือหารือการขนส่งตามพื้นที่และชนิดสินค้า ไม่ใช่การรับถึงบ้านทุกจังหวัด' },
  { n: 4, title: 'ชำระเงินหลังตกลงราคา',       desc: 'ชำระเงินหลังตรวจสอบสินค้าและตกลงราคาเรียบร้อยแล้ว'   },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={pageUrl}
  ogImage={resolvedOgImage}
  heroImage={resolvedHeroImage}
  breadcrumbs={breadcrumbs}
  pageType="WebPage"
  mainEntityId={schemaIds.service(pageUrl)}
  datePublished={datePublished}
  dateModified={dateModified}
  geoPlace={area?.data.province}
  schemaExtras={schemaExtras}
>
  <!-- Page hero -->
  <header class="page-header">
    <div class="container page-header__grid">
      <div>
        <span class="tag tag--orange" style="margin-bottom:.875rem;">
          {area ? area.data.province : 'ภาคอีสาน'}
        </span>
        <h1>{h1}</h1>
        <p class="page-header__desc">{description}</p>
        <div class="page-header__cta">
          <a href={site.line} class="btn btn--line" target="_blank" rel="noopener noreferrer" data-track-cta data-cta-type="line" data-cta-position="hero" data-destination="line">
            แชท Line ประเมินราคา
          </a>
          <a href={`tel:${site.phoneTel}`} class="btn btn--ghost" data-track-cta data-cta-type="phone" data-cta-position="hero" data-destination="phone">
            โทร {site.phone}
          </a>
        </div>
      </div>
      {resolvedHeroImage && (
        <figure class="page-header__figure">
          <OptimizedImage
            src={resolvedHeroImage}
            alt={getImageAlt(resolvedHeroImage, `${service?.data.mainKeyword ?? mainKeyword} มือสองสำหรับประเมินราคา`)}
            loading="eager"
            width={600}
            height={338}
          />
        </figure>
      )}
    </div>
  </header>

  <!-- Content + sidebar -->
  <div class="container content-layout">
    <article class="prose">
      <div role="note" class="regional-intake-disclosure">
        <strong>ข้อมูลการติดต่อและการส่งมอบจริง:</strong>
        <span>ดำเนินการโดย บริษัท อำพล เทรดดิ้ง จำกัด มีหน้าร้านจริงที่ 740/8 ถนนชยางกูร อำเภอเมืองอุบลราชธานี จุดสังเกตปากซอยชยางกูร 32 เปิดหน้าร้าน 09:00–19:00 น.</span>
        <span>เสนอขายสินค้าผ่าน <a href={site.line} target="_blank" rel="noopener noreferrer">LINE @webuy</a> ได้ 24 ชั่วโมง (รับข้อความ ไม่ใช่เจ้าหน้าที่ตอบตลอด 24 ชั่วโมง) การตรวจรับ นัดหมาย หรือขนส่งต้องตกลงตามชนิดสินค้า มูลค่า และพื้นที่จริง {area && area.data.slug !== 'อุบลราชธานี' ? `ไม่มีสาขาหรือทีมรับสินค้าประจำจังหวัด${area.data.province}` : 'สินค้าขนาดใหญ่ควรนัดหมายก่อนเดินทางมาหน้าร้าน'}</span>
      </div>
      {macbookProfile ? <MacbookServiceAreaContent profile={macbookProfile} /> : <Content />}
    </article>

    <aside class="sidebar">
      <div class="sidebar__box">
        <p class="sidebar__title">ประเมินราคาฟรี</p>
        <div style="display:flex;flex-direction:column;gap:.625rem;">
          <a href={site.line} class="btn btn--line btn--sm" target="_blank" rel="noopener noreferrer" data-track-cta data-cta-type="line" data-cta-position="card" data-destination="line">
            แชท Line @webuy
          </a>
          <a href={`tel:${site.phoneTel}`} class="btn btn--phone btn--sm" data-track-cta data-cta-type="phone" data-cta-position="card" data-destination="phone">
            โทร {site.phone}
          </a>
        </div>
      </div>

      {service && (
        <div class="sidebar__box">
          <p class="sidebar__title">บริการที่เกี่ยวข้อง</p>
          <ul class="sidebar__links">
            <li>
              <a href={serviceHref}>{service.data.title}</a>
            </li>
          </ul>
        </div>
      )}

      {area && (
        <div class="sidebar__box">
          <p class="sidebar__title">พื้นที่ให้บริการ</p>
          <ul class="sidebar__links">
            <li>
              <a href={`/พื้นที่ให้บริการ/${area.data.slug}`}>{area.data.title}</a>
            </li>
          </ul>
        </div>
      )}

      {relatedInProvince.length > 0 && area && (
        <div class="sidebar__box">
          <p class="sidebar__title">บริการอื่นใน{area.data.province}</p>
          <ul class="sidebar__links">
            {relatedInProvince.map((related) => (
              <li>
                <a href={`/รับซื้อ/${related.data.slug}`}>
                  {serviceAreaSidebarLabel(related)}
                </a>
              </li>
            ))}
          </ul>
          <p style="margin-top:.875rem;margin-bottom:0;">
            <a href={`/พื้นที่ให้บริการ/${area.data.slug}`} class="sidebar__view-all">
              ดูภาพรวมพื้นที่{area.data.province} →
            </a>
          </p>
        </div>
      )}
    </aside>
  </div>

  <!-- Steps -->
  <section class="section section--gray">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">วิธีขาย</span>
        <h2>ขายสินค้า{area ? `ใน${area.data.province}` : ''} ง่ายใน 4 ขั้นตอน</h2>
      </div>
      <div class="steps">
        {steps.map((s) => (
          <div class="step">
            <span class="step__number">{s.n}</span>
            <h3 class="step__title">{s.title}</h3>
            <p class="step__desc">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FAQ items={faqs} />
  <CTAContact title={`${title} — นัดประเมินราคาฟรีวันนี้`} />
</BaseLayout>

<style>
  .regional-intake-disclosure {
    display: grid;
    gap: .35rem;
    margin-bottom: 1.35rem;
    padding: .95rem 1.1rem;
    border: 1px solid var(--color-border, #d9dfdf);
    border-radius: .75rem;
    font-size: .93rem;
    line-height: 1.65;
  }
  .regional-intake-disclosure strong { display: block; }
  .regional-intake-disclosure span { display: block; }
</style>
