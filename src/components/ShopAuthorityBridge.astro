---
import type { ShopAuthorityTarget } from '../config/shop-authority-map'

interface Props {
  targets?: ShopAuthorityTarget[]
}
const { targets = [] } = Astro.props
---

{targets.length > 0 && (
  <aside class="shop-authority-bridge" aria-label="สินค้ามือสองที่เกี่ยวข้องใน AMPHON SHOP">
    <div class="shop-authority-bridge__head">
      <span>อ่านเพื่อขายอยู่ หรือกำลังหาซื้อ?</span>
      <strong>ถ้าต้องการซื้อ ดูสินค้าจริงใน AMPHON SHOP</strong>
      <p>บทความนี้อยู่บนเว็บไซต์รับซื้อของ AMPHON TRADING ส่วนลิงก์ด้านล่างพาไปหน้าร้านสำหรับเลือกซื้อ จึงไม่สลับเจตนาการค้นหาของสองเว็บไซต์เข้าด้วยกัน</p>
    </div>
    <div class="shop-authority-bridge__grid">
      {targets.map((target) => (
        <a href={target.href} class="shop-authority-bridge__card">
          <strong>{target.title}</strong>
          <span>{target.summary}</span>
          <b>{target.label} →</b>
        </a>
      ))}
    </div>
  </aside>
)}

<style>
.shop-authority-bridge{margin:2.2rem 0;padding:1.25rem;border:1px solid rgba(249 115 22/.2);border-radius:1rem;background:rgba(249 115 22/.035)}
.shop-authority-bridge__head{display:grid;gap:.35rem;margin-bottom:1rem}
.shop-authority-bridge__head>span{color:var(--color-primary);font-size:.78rem;font-weight:800}
.shop-authority-bridge__head>strong{font-size:1.08rem}
.shop-authority-bridge__head p{margin:0;color:var(--color-gray-600);font-size:.9rem;line-height:1.65}
.shop-authority-bridge__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}
.shop-authority-bridge__card{display:grid;gap:.35rem;padding:1rem;border:1px solid rgba(15 23 42/.09);border-radius:.8rem;background:#fff;text-decoration:none}
.shop-authority-bridge__card strong{color:var(--color-dark)}
.shop-authority-bridge__card span{color:var(--color-gray-600);font-size:.86rem;line-height:1.55}
.shop-authority-bridge__card b{color:var(--color-primary);font-size:.83rem}
@media(max-width:767px){.shop-authority-bridge__grid{grid-template-columns:1fr}}
</style>
