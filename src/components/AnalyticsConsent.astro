---
/**
 * Minimal analytics consent banner (first-party gate before loading GA4).
 * Not a legal-compliance certification.
 */
---

<div
  id="analytics-consent"
  class="analytics-consent"
  hidden
  role="dialog"
  aria-modal="false"
  aria-labelledby="analytics-consent-title"
  aria-describedby="analytics-consent-desc"
>
  <div class="analytics-consent__inner">
    <div class="analytics-consent__text">
      <p id="analytics-consent-title" class="analytics-consent__title">การวิเคราะห์การใช้งานเว็บไซต์</p>
      <p id="analytics-consent-desc" class="analytics-consent__desc">
        เราใช้เครื่องมือวิเคราะห์ (Google Analytics) เพื่อดูว่าผู้เยี่ยมชมโต้ตอบกับปุ่มติดต่ออย่างไร
        ไม่ใช้เพื่อเก็บข้อมูลส่วนตัวจากฟอร์มขายสินค้า
        อ่านรายละเอียดได้ที่
        <a href="/privacy-policy">นโยบายความเป็นส่วนตัว</a>
      </p>
    </div>
    <div class="analytics-consent__actions">
      <button type="button" class="btn btn--outline analytics-consent__btn" data-consent-action="deny">
        ไม่ยอมรับ
      </button>
      <button type="button" class="btn btn--primary analytics-consent__btn" data-consent-action="grant">
        ยอมรับการวิเคราะห์
      </button>
    </div>
  </div>
</div>

<style>
  .analytics-consent {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 120;
    padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom, 0));
    background: rgba(15, 23, 42, 0.96);
    color: #f8fafc;
    border-top: 1px solid rgba(255 255 255 / 0.12);
    box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.2);
  }

  .analytics-consent[hidden] {
    display: none !important;
  }

  .analytics-consent__inner {
    max-width: 1100px;
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.25rem;
    align-items: center;
    justify-content: space-between;
  }

  .analytics-consent__title {
    margin: 0 0 0.25rem;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .analytics-consent__desc {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.45;
    color: rgba(248 250 252 / 0.88);
    max-width: 52rem;
  }

  .analytics-consent__desc a {
    color: #93c5fd;
    text-decoration: underline;
  }

  .analytics-consent__desc a:focus-visible {
    outline: 2px solid #93c5fd;
    outline-offset: 2px;
  }

  .analytics-consent__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .analytics-consent__btn {
    min-height: 2.5rem;
  }

  .analytics-consent__btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  @media (max-width: 720px) {
    .analytics-consent {
      /* Sit above sticky CTA (~3.5rem) */
      bottom: 3.6rem;
      padding-bottom: 0.75rem;
    }

    .analytics-consent__actions {
      width: 100%;
    }

    .analytics-consent__btn {
      flex: 1 1 auto;
    }
  }
</style>
