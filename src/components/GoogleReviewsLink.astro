---
import { staticGoogleMapsReviewsUrl } from '../lib/google-maps';

const googleMapsUrl = staticGoogleMapsReviewsUrl();
---

<aside class="google-reviews-link" data-google-reviews-compact aria-labelledby="google-reviews-trust-heading">
  <div>
    <h2 id="google-reviews-trust-heading">ตรวจสอบความน่าเชื่อถือของร้าน</h2>
    <p>รีวิวมาจากผู้ใช้ที่แสดงความคิดเห็นบน Google Maps หน้าร้านหลักของบริษัท อำพล เทรดดิ้ง อยู่จังหวัดอุบลราชธานี ส่วนพื้นที่อื่นให้บริการนัดรับหรือประสานจัดส่งตามเงื่อนไข</p>
  </div>
  <div class="google-reviews-link__actions">
    <a class="btn btn--outline" href={googleMapsUrl} target="_blank" rel="noopener noreferrer">ดูรีวิวทั้งหมดบน Google Maps</a>
    <a class="btn btn--ghost" href="/contact">ดูข้อมูลหน้าร้าน</a>
  </div>
</aside>

<style>
  .google-reviews-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin-block: 2.5rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-md);
    background: var(--color-white);
  }
  .google-reviews-link h2 { margin: 0 0 .4rem; font-size: 1.25rem; }
  .google-reviews-link p { max-width: 46rem; margin: 0; }
  .google-reviews-link__actions { display: flex; flex: 0 0 auto; flex-wrap: wrap; gap: .75rem; }
  @media (max-width: 800px) {
    .google-reviews-link { align-items: flex-start; flex-direction: column; }
  }
</style>
