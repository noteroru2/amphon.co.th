---
import type { MacbookServiceAreaProfile } from '../config/macbook-service-areas';

interface Props {
  profile: MacbookServiceAreaProfile;
}

const { profile } = Astro.props;
---

<p>{profile.intro}</p>

<h2>เริ่มขาย MacBook จาก{profile.province}อย่างไร</h2>
<p>{profile.servicePlan}</p>

<h3>พื้นที่ใน{profile.province}ที่ใช้แนวทางนี้ได้</h3>
<p>
  ตัวอย่างพื้นที่ ได้แก่ {profile.districts.join(' • ')} และอำเภออื่นในจังหวัด
  รายชื่อพื้นที่เป็นข้อมูลประกอบการวางแผน ไม่ได้หมายความว่ามีสาขาหรือทีมรับประจำทุกอำเภอ
</p>

<h2>ข้อมูลที่ช่วยให้ประเมินได้ใกล้เคียงขึ้น</h2>
<p>{profile.evaluationFocus}</p>
<ul>
  <li>รุ่น ปี ชิป ขนาดหน้าจอ RAM และความจุ</li>
  <li>รูปตัวเครื่องทุกด้าน หน้าจอตอนเปิด และตำหนิแบบใกล้</li>
  <li>รอบชาร์จ สุขภาพแบตเตอรี่ อุปกรณ์ และประวัติซ่อม</li>
  <li>ยืนยันว่าเจ้าของสามารถออกจาก Apple ID และปิด Find My ได้</li>
</ul>

<h2>เตรียม MacBook สำหรับการส่งมอบจาก{profile.province}</h2>
<p>{profile.packingFocus}</p>
<p>
  อย่าเปิดเผยรหัสผ่านในแชท สำรองข้อมูลส่วนตัวไว้ก่อน และรอคำยืนยันขั้นตอนก่อนล้างเครื่อง
  หากมีแบตเตอรี่บวม กลิ่นไหม้ หรือความเสียหายที่อาจไม่ปลอดภัย ต้องแจ้งก่อนเลือกวิธีขนส่ง
</p>

<h2>การตรวจเครื่องและยืนยันราคา</h2>
<p>{profile.handoff}</p>
<p>
  ราคาจากรูปเป็นเพียงการประเมินเบื้องต้น ไม่ใช่ราคาสุดท้าย เพราะรุ่นย่อย สเปก
  การล็อกบัญชี และอาการที่ตรวจพบจากเครื่องจริงอาจทำให้ราคาเปลี่ยนได้
</p>

<h2>อ่านข้อมูลที่ตรงกับเครื่องก่อนติดต่อ</h2>
<p>
  <a href={profile.supportHref}>{profile.supportLabel}</a> — {profile.supportDescription}
  หรือกลับไปดู <a href="/บริการ/รับซื้อ-macbook">ศูนย์รวมบริการรับซื้อ MacBook</a>
  เพื่อเลือกหน้ารุ่นและสภาพที่ตรงกว่า
</p>

<h2>ขอประเมิน MacBook จาก{profile.province}</h2>
<p>{profile.cta}</p>
