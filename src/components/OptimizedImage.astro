---
import { getImageAlt } from '../config/images';
import { getCachedDimensions, loadDimensionCache } from '../../scripts/lib/local-image-dimensions-cache.mjs';

interface Props {
  src: string;
  alt?: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'auto' | 'low';
  class?: string;
  sizes?: string;
  style?: string;
}

const {
  src,
  alt,
  width,
  height,
  loading = 'lazy',
  fetchpriority,
  class: className,
  sizes,
  style,
} = Astro.props;

loadDimensionCache();
const cached = getCachedDimensions(src);
const resolvedWidth = width ?? cached?.width;
const resolvedHeight = height ?? cached?.height;

const resolvedAlt = alt ?? getImageAlt(src, '');

// Auto-generate sizes if not provided but width is known
const resolvedSizes = sizes ?? (resolvedWidth ? `(max-width: 640px) 100vw, ${resolvedWidth}px` : undefined);
---

<img
  src={src}
  alt={resolvedAlt}
  width={resolvedWidth}
  height={resolvedHeight}
  loading={loading}
  decoding="async"
  class={className}
  sizes={resolvedSizes}
  style={style}
  {...(fetchpriority ? { fetchpriority } : {})}
/>
