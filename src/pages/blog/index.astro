---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import CTAContact from '../../components/CTAContact.astro';
import RescueLinkGroups from '../../components/RescueLinkGroups.astro';
import { getCollection } from 'astro:content';
import { absoluteUrl, schemaIds, createItemListSchema } from '../../lib/seo';
import { buildSeoRescueGroups } from '../../config/seo-rescue';

const sameDayPriority = new Map([
  ['ขายโทรศัพท์มือสองใกล้ฉัน', 0],
  ['ขายกล้อง-sony-มือสอง-ต้องเช็กอะไรบ้าง', 1],
  ['mac-mini-m4-มือสอง', 2],
  ['แรมมือสองขายได้เท่าไหร่', 3],
]);

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => {
    const aTime = Number.isFinite(a.data.date.valueOf())
      ? a.data.date.valueOf()
      : Number.NEGATIVE_INFINITY;
    const bTime = Number.isFinite(b.data.date.valueOf())
      ? b.data.date.valueOf()
      : Number.NEGATIVE_INFINITY;

    if (aTime !== bTime) return bTime - aTime;

    const priorityDifference =
      (sameDayPriority.get(a.data.slug) ?? Number.MAX_SAFE_INTEGER) -
      (sameDayPriority.get(b.data.slug) ?? Number.MAX_SAFE_INTEGER);

    return priorityDifference || a.data.slug.localeCompare(b.data.slug, 'th');
  },
);
const services = (await getCollection('services', ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999),
);
const rescueGroups = buildSeoRescueGroups(services);

const breadcrumbs = [
  { label: 'หน้าแรก', href: '/' },
  { label: 'บทความ' },
];

const pageUrl = absoluteUrl('/blog');
const schemaExtras = [
  createItemListSchema({
    pageUrl,
    name: 'บทความและคำแนะนำ',
    items: posts.map((post) => ({
      name: post.data.title,
      url: absoluteUrl(`/blog/${post.data.slug}`),
      description: post.data.description,
    })),
  }),
];
---

<BaseLayout
  title="บทความและคำแนะนำ"
  description="บทความคำแนะนำการขายสินค้าไอที เช็กราคา เตรียมเครื่อง และวางแผนก่อนส่งขาย"
  canonical={pageUrl}
  breadcrumbs={breadcrumbs}
  pageType="CollectionPage"
  mainEntityId={schemaIds.itemList(pageUrl)}
  schemaExtras={schemaExtras}
>
  <header class="page-header blog-hero">
    <div class="container">
      <span class="tag tag--orange" style="margin-bottom:.875rem;">สาระความรู้</span>
      <h1>บทความและคำแนะนำ</h1>
      <p class="page-header__desc">
        แหล่งรวมคำแนะนำ วิธีเช็กสภาพเครื่อง และข้อมูลที่ควรรู้ก่อนขายสินค้าไอที
      </p>
      <p class="blog-hero__description">
        รวมคู่มือก่อนขายโน๊ตบุ๊ค โทรศัพท์ iPhone iPad MacBook คอมพิวเตอร์ กล้อง และอุปกรณ์ไอทีมือสอง
        ตั้งแต่วิธีเช็กสเปก ตรวจสภาพ สำรองและลบข้อมูล ไปจนถึงการเตรียมรูปเพื่อขอราคาประเมินเบื้องต้น
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="grid grid--3">
        {posts.map((post) => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            href={`/blog/${post.data.slug}`}
            date={post.data.date}
            tags={post.data.tags}
          />
        ))}
      </div>
    </div>
  </section>

  <RescueLinkGroups
    eyebrow="บทความเชื่อมหน้าบริการ"
    title="ทางลัดไปหน้าบริการหลักและหน้ารุ่นย่อย"
    description="ใช้หน้าบทความเป็นอีกหนึ่ง hub สำหรับเชื่อมไปยังบริการที่มี intent ชัดเจน ช่วยเพิ่มเส้นทาง crawl จากบทความเข้าสู่หน้ารับซื้อโดยตรง."
    groups={rescueGroups}
  />

  <CTAContact compact title="มีสินค้าอยากขาย? ปรึกษาทีมงาน Amphon ฟรี" />
</BaseLayout>

<style>
  .page-header.blog-hero {
    padding-block: 4rem;
  }

  .blog-hero .page-header__desc {
    color: #cbd5e1;
  }

  .blog-hero__description {
    max-width: 760px;
    color: #dbe4f0;
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.8;
    margin: 1.25rem 0 0;
  }

  @media (max-width: 767px) {
    .page-header.blog-hero {
      padding-block: 2.5rem;
    }

    .blog-hero__description {
      font-size: 1rem;
      line-height: 1.75;
    }
  }
</style>
